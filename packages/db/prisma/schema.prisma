generator client {
  provider   = "prisma-client"
  output     = "../src/generated/prisma"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  passwordHash    String   @map("password_hash")
  name            String?
  workspaceLayout String?  @map("workspace_layout")
  activeLayoutId  String?  @map("active_layout_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  sessions            Session[]
  providers           Provider[]
  modelSettings       UserModelSetting?
  dataSourceInstances DataSourceInstance[]
  chartDrawings       ChartDrawing[]
  chartConfigs        UserChartConfig[]
  workspaceLayouts    WorkspaceLayout[]
  workflows           Workflow[]
  agents              Agent[]
  agentSessions       AgentSession[]
  agentMessages       AgentMessage[]
  agentResources      AgentResource[]
  agentObservations   AgentObservationalMemory[]
  agentMemories       AgentMemory[]
  agentExperiences    AgentExperience[]
  agentSkills         AgentSkill[]
  agentMcpServers     AgentMcpServer[]
  knowledgeBases      KnowledgeBase[]
  notifications       Notification[]

  @@map("users")
}

model Notification {
  id          String    @id @default(cuid())
  userId      String    @map("user_id")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String
  severity    String    @default("info")
  title       String
  message     String
  entityType  String?   @map("entity_type")
  entityId    String?   @map("entity_id")
  actionUrl   String?   @map("action_url")
  payload     String    @default("{}")
  readAt      DateTime? @map("read_at")
  archivedAt  DateTime? @map("archived_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@index([userId, archivedAt])
  @@index([userId, type])
  @@map("notifications")
}

model WorkspaceLayout {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String   @default("Default")
  schemaJson String   @default("null") @map("schema_json")
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("workspace_layouts")
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([token])
  @@map("sessions")
}

model Provider {
  id              String   @id @default(cuid())
  name            String
  kind            String
  apiFormat       String   @default("openai-compatible") @map("api_format")
  baseUrl         String
  apiKeyEncrypted String
  apiKeyIv        String
  isActive        Boolean  @default(true)
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  models ProviderModel[]

  @@unique([userId, name])
  @@map("providers")
}

model ProviderModel {
  id           String   @id @default(cuid())
  providerId   String   @map("provider_id")
  modelId      String   @map("model_id") // "gpt-4o"
  displayName  String?  @map("display_name") // "GPT-4o"
  maxTokens    Int?     @map("max_tokens")
  capabilities String   @default("[]") // JSON string array
  enabled      Boolean  @default(true)
  provider     Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now()) @map("created_at")

  @@unique([providerId, modelId])
  @@map("provider_models")
}

model UserModelSetting {
  id                    String   @id @default(cuid())
  userId                String   @unique @map("user_id")
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  compressionProviderId String?  @map("compression_provider_id")
  compressionModelId    String?  @map("compression_model_id")
  embeddingProviderId   String?  @map("embedding_provider_id")
  embeddingModelId      String?  @map("embedding_model_id")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@map("user_model_settings")
}

model DataSourceInstance {
  id               String             @id @default(cuid())
  name             String
  providerKind     String
  defaultSymbol    String             @map("default_symbol")
  identityKey      String?            @map("identity_key")
  identityLabel    String?            @map("identity_label")
  configEncrypted  String
  configIv         String
  userId           String
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  trackedSymbols   TrackedSymbol[]
  chartDrawings    ChartDrawing[]
  marketDataSeries MarketDataSeries[]
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  @@unique([userId, name])
  @@map("data_source_instances")
}

model TrackedSymbol {
  id         String             @id @default(cuid())
  instanceId String
  symbol     String
  name       String
  exchange   String?
  type       String?
  instance   DataSourceInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  createdAt  DateTime           @default(now()) @map("created_at")

  @@unique([instanceId, symbol])
  @@map("tracked_symbols")
}

model MarketDataSeries {
  id                   String             @id @default(cuid())
  dataSourceInstanceId String             @map("data_source_instance_id")
  dataSourceInstance   DataSourceInstance @relation(fields: [dataSourceInstanceId], references: [id], onDelete: Cascade)
  providerKind         String             @map("provider_kind")
  identityKey          String?            @map("identity_key")
  symbol               String
  interval             String
  timezone             String             @default("UTC")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  bars      MarketDataKlineBar[]
  syncState MarketDataSyncState?

  @@unique([dataSourceInstanceId, symbol, interval])
  @@index([providerKind, identityKey, symbol, interval])
  @@map("market_data_series")
}

model MarketDataKlineBar {
  id        String           @id @default(cuid())
  seriesId  String           @map("series_id")
  series    MarketDataSeries @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  openTime  DateTime         @map("open_time")
  closeTime DateTime         @map("close_time")
  open      Decimal
  high      Decimal
  low       Decimal
  close     Decimal
  volume    Decimal?
  isFinal   Boolean          @default(true) @map("is_final")
  source    String           @default("provider")
  fetchedAt DateTime         @default(now()) @map("fetched_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  @@unique([seriesId, openTime])
  @@index([seriesId, openTime])
  @@index([seriesId, isFinal, openTime])
  @@map("market_data_kline_bars")
}

model MarketDataSyncState {
  id                    String           @id @default(cuid())
  seriesId              String           @unique @map("series_id")
  series                MarketDataSeries @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  earliestFinalOpenTime DateTime?        @map("earliest_final_open_time")
  latestFinalOpenTime   DateTime?        @map("latest_final_open_time")
  latestLiveOpenTime    DateTime?        @map("latest_live_open_time")
  lastFetchAt           DateTime?        @map("last_fetch_at")
  lastFetchError        String?          @map("last_fetch_error")
  updatedAt             DateTime         @updatedAt @map("updated_at")

  @@map("market_data_sync_states")
}

model ChartDrawing {
  id         String             @id @default(cuid())
  userId     String             @map("user_id")
  instanceId String             @map("instance_id")
  symbol     String
  payload    String             @default("[]")
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  instance   DataSourceInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  createdAt  DateTime           @default(now()) @map("created_at")
  updatedAt  DateTime           @updatedAt @map("updated_at")

  @@unique([userId, instanceId, symbol])
  @@index([instanceId, symbol])
  @@map("chart_drawings")
}

model UserChartConfig {
  id               String   @id @default(cuid())
  userId           String   @map("user_id")
  scope            String   @default("default")
  autoSaveDrawings Boolean  @default(false) @map("auto_save_drawings")
  intervalSettings String   @default("{\"visible\":[],\"custom\":[]}") @map("interval_settings")
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@unique([userId, scope])
  @@map("user_chart_configs")
}

model Workflow {
  id              String   @id @default(cuid())
  userId          String   @map("user_id")
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  description     String?
  definition      String
  enabled         Boolean  @default(false)
  activeVersionId String?  @map("active_version_id")
  currentSeq      Int      @default(0) @map("current_seq")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  versions       WorkflowVersion[] @relation("WorkflowVersions")
  activeVersion  WorkflowVersion?  @relation("WorkflowActiveVersion", fields: [activeVersionId], references: [id], onDelete: SetNull)
  nodeExecutions WorkflowNodeExecution[]
  editEvents     WorkflowEditEvent[]
  runs           WorkflowRun[]

  @@index([userId])
  @@index([enabled])
  @@map("workflows")
}

model WorkflowEditEvent {
  id                 String   @id @default(cuid())
  workflowId         String   @map("workflow_id")
  workflow           Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  userId             String   @map("user_id")
  seq                Int
  kind               String
  label              String?
  opsJson            String   @default("[]") @map("ops_json")
  inverseOpsJson     String   @default("[]") @map("inverse_ops_json")
  snapshotName       String?  @map("snapshot_name")
  snapshotDefinition String?  @map("snapshot_definition")
  targetVersionId    String?  @map("target_version_id")
  targetDefinition   String?  @map("target_definition")
  clientBatchId      String?  @map("client_batch_id")
  targetSeq          Int?     @map("target_seq")
  createdAt          DateTime @default(now()) @map("created_at")

  @@unique([workflowId, seq])
  @@unique([workflowId, clientBatchId])
  @@index([workflowId, kind, seq])
  @@index([userId])
  @@map("workflow_edit_events")
}

model WorkflowVersion {
  id         String   @id @default(cuid())
  workflowId String   @map("workflow_id")
  workflow   Workflow @relation("WorkflowVersions", fields: [workflowId], references: [id], onDelete: Cascade)
  version    Int
  definition String
  note       String?
  createdAt  DateTime @default(now()) @map("created_at")
  createdBy  String   @map("created_by")

  activeFor Workflow[]    @relation("WorkflowActiveVersion")
  runs      WorkflowRun[]

  @@unique([workflowId, version])
  @@index([workflowId])
  @@map("workflow_versions")
}

model WorkflowRun {
  id                String    @id @default(cuid())
  workflowId        String    @map("workflow_id")
  workflow          Workflow  @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  workflowVersionId String?          @map("workflow_version_id")
  workflowVersion   WorkflowVersion? @relation(fields: [workflowVersionId], references: [id], onDelete: SetNull)
  userId            String    @map("user_id")
  trigger           String
  source            String   @default("published")
  status            String
  definition        String
  report            String?
  error             String?
  startedAt         DateTime @default(now()) @map("started_at")
  finishedAt        DateTime? @map("finished_at")
  durationMs        Int?     @map("duration_ms")
  createdAt         DateTime @default(now()) @map("created_at")

  nodeExecutions WorkflowRunNodeExecution[]

  @@index([workflowId, startedAt])
  @@index([workflowVersionId])
  @@index([userId])
  @@index([status])
  @@map("workflow_runs")
}

model WorkflowRunNodeExecution {
  id         String   @id @default(cuid())
  runId      String   @map("run_id")
  run        WorkflowRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  workflowId String   @map("workflow_id")
  userId     String   @map("user_id")
  nodeId     String   @map("node_id")
  nodeType   String   @map("node_type")
  status     String
  inputs     String
  outputs    String?
  logs       String   @default("[]")
  error      String?
  startedAt  DateTime @default(now()) @map("started_at")
  finishedAt DateTime? @map("finished_at")
  durationMs Int?     @map("duration_ms")

  @@index([runId])
  @@index([workflowId, nodeId])
  @@index([userId])
  @@map("workflow_run_node_executions")
}

model WorkflowNodeExecution {
  id             String    @id @default(cuid())
  workflowId     String    @map("workflow_id")
  userId         String    @map("user_id")
  nodeId         String    @map("node_id")
  nodeType       String    @map("node_type")
  status         String
  inputs         String
  outputs        String?
  error          String?
  logs           String    @default("[]")
  definitionHash String    @map("definition_hash")
  durationMs     Int?      @map("duration_ms")
  startedAt      DateTime  @default(now()) @map("started_at")
  finishedAt     DateTime? @map("finished_at")

  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowId, nodeId, definitionHash])
  @@index([userId])
  @@map("workflow_node_executions")
}

model Agent {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  instructions String?
  providerId   String?  @map("provider_id")
  modelId      String?  @map("model_id")
  toolScope    String   @default("[]") @map("tool_scope")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  sessions       AgentSession[]
  memories       AgentMemory[]
  experiences    AgentExperience[]
  skills         AgentSkill[]
  mcpServers     AgentMcpServer[]
  knowledgeBases KnowledgeBase[]

  @@index([userId])
  @@map("agents")
}

model AgentSession {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  agentId    String   @map("agent_id")
  agent      Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  title      String
  summary    String?
  workflowId String?  @map("workflow_id")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  messages  AgentMessage[]
  summaries AgentSummary[]
  memories  AgentMemory[]

  @@index([userId])
  @@index([agentId])
  @@map("agent_sessions")
}

model AgentMessage {
  id         String       @id @default(cuid())
  userId     String       @map("user_id")
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId  String       @map("session_id")
  session    AgentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role       String
  type       String       @default("text")
  resourceId String?      @map("resource_id")
  content    String
  metadata   String       @default("{}")
  createdAt  DateTime     @default(now()) @map("created_at")

  @@index([userId])
  @@index([sessionId, createdAt])
  @@index([resourceId])
  @@map("agent_messages")
}

model AgentResource {
  id            String   @id
  userId        String   @map("user_id")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  workingMemory String?  @map("working_memory")
  metadata      String   @default("{}")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("agent_resources")
}

model AgentObservationalMemory {
  id         String   @id
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  threadId   String?  @map("thread_id")
  resourceId String   @map("resource_id")
  scope      String
  originType String   @map("origin_type")
  payload    String
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([resourceId, scope, createdAt])
  @@index([threadId])
  @@index([userId])
  @@map("agent_observational_memories")
}

model AgentSummary {
  id            String       @id @default(cuid())
  sessionId     String       @map("session_id")
  session       AgentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  content       String
  fromMessageId String?      @map("from_message_id")
  toMessageId   String?      @map("to_message_id")
  createdAt     DateTime     @default(now()) @map("created_at")

  @@index([sessionId])
  @@map("agent_summaries")
}

model AgentMemory {
  id         String        @id @default(cuid())
  userId     String        @map("user_id")
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  agentId    String?       @map("agent_id")
  agent      Agent?        @relation(fields: [agentId], references: [id], onDelete: Cascade)
  sessionId  String?       @map("session_id")
  session    AgentSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  scope      String
  targetId   String        @map("target_id")
  kind       String
  content    String
  tags       String        @default("[]")
  importance Int           @default(1)
  confidence Float         @default(0.7)
  enabled    Boolean       @default(true)
  source     String        @default("manual")
  metadata   String        @default("{}")
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")

  @@index([userId, scope, targetId])
  @@index([agentId])
  @@index([sessionId])
  @@map("agent_memories")
}

model AgentExperience {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  agentId    String   @map("agent_id")
  agent      Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  sessionId  String?  @map("session_id")
  title      String
  content    String
  tags       String   @default("[]")
  importance Int      @default(1)
  confidence Float    @default(0.7)
  enabled    Boolean  @default(true)
  source     String   @default("auto")
  metadata   String   @default("{}")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([userId, agentId])
  @@index([sessionId])
  @@map("agent_experiences")
}

model AgentSkill {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  agentId     String?  @map("agent_id")
  agent       Agent?   @relation(fields: [agentId], references: [id], onDelete: Cascade)
  packageName String   @map("package_name")
  version     String?
  displayName String   @map("display_name")
  description String?
  config      String   @default("{}")
  enabled     Boolean  @default(true)
  source      String   @default("installed")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([userId, agentId, packageName])
  @@index([userId])
  @@index([agentId])
  @@map("agent_skills")
}

model AgentMcpServer {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  agentId   String?  @map("agent_id")
  agent     Agent?   @relation(fields: [agentId], references: [id], onDelete: Cascade)
  name      String
  transport String
  command   String?
  url       String?
  config    String   @default("{}")
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, agentId, name])
  @@index([userId])
  @@index([agentId])
  @@map("agent_mcp_servers")
}

model KnowledgeBase {
  id            String   @id @default(cuid())
  userId        String   @map("user_id")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  agentId       String?  @map("agent_id")
  agent         Agent?   @relation(fields: [agentId], references: [id], onDelete: Cascade)
  name          String
  description   String?
  enabled       Boolean  @default(true)
  metadata      String   @default("{}")
  activeIndexId String?  @map("active_index_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  documents        KnowledgeDocument[]
  ingestionRuns    KnowledgeIngestionRun[]
  embeddingIndexes KnowledgeEmbeddingIndex[]

  @@index([userId])
  @@index([agentId])
  @@map("knowledge_bases")
}

model KnowledgeDocument {
  id              String        @id @default(cuid())
  knowledgeBaseId String        @map("knowledge_base_id")
  knowledgeBase   KnowledgeBase @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  title           String
  sourceType      String        @map("source_type")
  sourceUri       String?       @map("source_uri")
  sourceFileName  String?       @map("source_file_name")
  sourceMimeType  String?       @map("source_mime_type")
  sourceSize      Int?          @map("source_size")
  sourceHash      String?       @map("source_hash")
  strategy        String        @default("raw")
  status          String        @default("uploaded")
  content         String        @default("")
  metadata        String        @default("{}")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  chunks        KnowledgeChunk[]
  ingestionRuns KnowledgeIngestionRun[]

  @@index([knowledgeBaseId])
  @@index([status])
  @@index([strategy])
  @@map("knowledge_documents")
}

model KnowledgeIngestionRun {
  id                String            @id @default(cuid())
  knowledgeBaseId   String            @map("knowledge_base_id")
  knowledgeBase     KnowledgeBase     @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  documentId        String            @map("document_id")
  document          KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  status            String            @default("pending")
  strategy          String            @default("raw")
  parseConfig       String            @default("{}") @map("parse_config")
  chunkConfig       String            @default("{}") @map("chunk_config")
  compressionConfig String            @default("{}") @map("compression_config")
  embeddingConfig   String            @default("{}") @map("embedding_config")
  error             String?
  startedAt         DateTime?         @map("started_at")
  finishedAt        DateTime?         @map("finished_at")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  chunks KnowledgeChunk[]

  @@index([knowledgeBaseId])
  @@index([documentId])
  @@index([status])
  @@map("knowledge_ingestion_runs")
}

model KnowledgeChunk {
  id                String                 @id @default(cuid())
  documentId        String                 @map("document_id")
  document          KnowledgeDocument      @relation(fields: [documentId], references: [id], onDelete: Cascade)
  runId             String?                @map("run_id")
  run               KnowledgeIngestionRun? @relation(fields: [runId], references: [id], onDelete: SetNull)
  chunkIndex        Int                    @map("chunk_index")
  sourceRawChunkId  String?                @map("source_raw_chunk_id")
  compressedChunkId String?                @map("compressed_chunk_id")
  kind              String                 @default("raw")
  embeddingRole     String                 @default("indexed") @map("embedding_role")
  tokenCount        Int                    @default(0) @map("token_count")
  content           String
  embedding         Unsupported("vector")?
  metadata          String                 @default("{}")
  createdAt         DateTime               @default(now()) @map("created_at")

  embeddings KnowledgeEmbedding[]

  @@unique([documentId, chunkIndex])
  @@index([documentId])
  @@index([runId])
  @@index([kind])
  @@index([embeddingRole])
  @@index([sourceRawChunkId])
  @@map("knowledge_chunks")
}

model KnowledgeEmbeddingIndex {
  id              String        @id @default(cuid())
  knowledgeBaseId String        @map("knowledge_base_id")
  knowledgeBase   KnowledgeBase @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  providerId      String        @map("provider_id")
  modelId         String        @map("model_id")
  dimension       Int
  status          String        @default("building")
  chunkConfigHash String?       @map("chunk_config_hash")
  strategy        String        @default("raw")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  embeddings KnowledgeEmbedding[]

  @@index([knowledgeBaseId])
  @@index([status])
  @@index([providerId, modelId])
  @@map("knowledge_embedding_indexes")
}

model KnowledgeEmbedding {
  id        String                  @id @default(cuid())
  indexId   String                  @map("index_id")
  index     KnowledgeEmbeddingIndex @relation(fields: [indexId], references: [id], onDelete: Cascade)
  chunkId   String                  @map("chunk_id")
  chunk     KnowledgeChunk          @relation(fields: [chunkId], references: [id], onDelete: Cascade)
  vector    Unsupported("vector")
  metadata  String                  @default("{}")
  createdAt DateTime                @default(now()) @map("created_at")

  @@unique([indexId, chunkId])
  @@index([indexId])
  @@index([chunkId])
  @@map("knowledge_embeddings")
}
