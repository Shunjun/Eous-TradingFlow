{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": ".",
    "jsx": "react-jsx",
    "noEmit": true,
    "paths": {
      "@": ["./src"],
      "@/*": ["./src/*"],
      "@eous/types": ["../../packages/types/src"],
      "@/components/*": ["../../packages/ui/src/components/*"],
      "@/lib/*": ["../../packages/ui/src/lib/*"],
      "@/hooks/*": ["../../packages/ui/src/hooks/*"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
