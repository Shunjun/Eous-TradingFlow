generator client {
  provider   = "prisma-client"
  output     = "../src/generated/prisma"
  engineType = "client"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  name             String?
  workspaceLayout  String?  @map("workspace_layout")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  sessions       Session[]
  providers      Provider[]
  dataSourceInstances DataSourceInstance[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([token])
  @@map("sessions")
}

model Provider {
  id              String   @id @default(cuid())
  name            String
  kind            String
  baseUrl         String
  apiKeyEncrypted String
  apiKeyIv        String
  isActive        Boolean  @default(true)
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  models         ProviderModel[]

  @@unique([userId, name])
  @@map("providers")
}

model ProviderModel {
  id           String   @id @default(cuid())
  providerId   String   @map("provider_id")
  modelId      String   @map("model_id")              // "gpt-4o"
  displayName  String?  @map("display_name")           // "GPT-4o"
  maxTokens    Int?     @map("max_tokens")
  capabilities String   @default("[]")                 // JSON string array
  enabled      Boolean  @default(true)
  provider     Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now()) @map("created_at")

  @@unique([providerId, modelId])
  @@map("provider_models")
}

model DataSourceInstance {
  id               String   @id @default(cuid())
  name             String
  providerKind     String
  identityKey      String?  @map("identity_key")
  identityLabel    String?  @map("identity_label")
  configEncrypted  String
  configIv         String
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  trackedSymbols   TrackedSymbol[]
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@unique([userId, name])
  @@map("data_source_instances")
}

model TrackedSymbol {
  id          String   @id @default(cuid())
  instanceId  String
  symbol      String
  name        String
  exchange    String?
  type        String?
  instance    DataSourceInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([instanceId, symbol])
  @@map("tracked_symbols")
}
