{
  "name": "eous-tradingflow",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "dev:deps": "docker compose -f docker-compose.dev.yml up -d",
    "dev:deps:down": "docker compose -f docker-compose.dev.yml down",
    "dev:deps:logs": "docker compose -f docker-compose.dev.yml logs -f",
    "dev:full": "pnpm dev:deps && turbo run dev",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "lefthook": "^2.1.9",
    "prettier": "^3.5.0",
    "turbo": "^2.4.0",
    "typescript": "^5.7.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "lightweight-charts-line-tools-core",
      "lightweight-charts-line-tools-lines",
      "lightweight-charts-line-tools-rectangle"
    ]
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.0.0"
  }
}
