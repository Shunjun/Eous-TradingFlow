DATABASE_URL="postgresql://eous:eous_password@localhost:5432/eous_tradingflow?schema=public"
REDIS_URL="redis://localhost:6379"

# ─── Server ─────────────────────────────────────────────
# Hono server port
PORT=3001

# Encryption key for provider API keys (AES-256-GCM)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Required for persisting encrypted provider keys. If not set, a random key will be generated on startup.
# ENCRYPTION_KEY=

# ─── Seed ───────────────────────────────────────────────
# Initial admin user created on first startup
INITIAL_USER_EMAIL=admin@eous.dev
INITIAL_USER_PASSWORD=changeme

# ─── Auth ───────────────────────────────────────────────
# Allow new users to self-register without invitation
ALLOW_SELF_REGISTRATION=true

# ─── Providers ──────────────────────────────────────────
# Optional outbound proxy used by data source providers.
# Supports http://, https://, socks:// and socks5:// proxy URLs.
# EOUS_PROVIDER_PROXY_URL=http://127.0.0.1:7890

# ─── Knowledge object storage ───────────────────────────
# Dev Docker uses MinIO. For local server dev outside Docker, endpoint points to localhost.
MINIO_ROOT_USER=eous
MINIO_ROOT_PASSWORD=eous_password
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
KNOWLEDGE_OBJECT_ENDPOINT=http://localhost:9000
KNOWLEDGE_OBJECT_REGION=us-east-1
KNOWLEDGE_OBJECT_BUCKET=knowledge
KNOWLEDGE_OBJECT_ACCESS_KEY=eous
KNOWLEDGE_OBJECT_SECRET_KEY=eous_password
KNOWLEDGE_OBJECT_FORCE_PATH_STYLE=true
